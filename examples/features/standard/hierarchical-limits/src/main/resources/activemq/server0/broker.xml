<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">
   <core xmlns="urn:activemq:core">

      <bindings-directory>./data/bindings</bindings-directory>

      <journal-directory>./data/journal</journal-directory>

      <large-messages-directory>./data/largemessages</large-messages-directory>

      <paging-directory>./data/paging</paging-directory>

      <!-- Acceptors -->
      <acceptors>
         <acceptor name="netty-acceptor">tcp://localhost:61616</acceptor>
      </acceptors>

      <literal-match-markers>()</literal-match-markers>

      <!-- Other config -->

      <security-settings>
         <!--security for all queues-->
         <security-setting match="#">
            <permission roles="guest" type="createAddress"/>
            <permission roles="guest" type="createDurableQueue"/>
            <permission roles="guest" type="deleteDurableQueue"/>
            <permission roles="guest" type="createNonDurableQueue"/>
            <permission roles="guest" type="deleteNonDurableQueue"/>
            <permission roles="guest" type="consume"/>
            <permission roles="guest" type="send"/>
            <permission roles="guest" type="manage"/>
            <permission roles="guest" type="deleteAddress"/>
         </security-setting>
      </security-settings>

      <address-settings>
         <!-- Default settings for all other addresses -->
         <address-setting match="#">
            <hierarchical>true</hierarchical>
            <dead-letter-address>DLQ</dead-letter-address>
            <expiry-address>ExpiryQueue</expiry-address>

            <auto-create-queues>true</auto-create-queues>
            <auto-create-addresses>true</auto-create-addresses>
            <hierarchical-full-policy>FAIL</hierarchical-full-policy>
            <max-hierarchical-messages>10</max-hierarchical-messages>
            <max-hierarchical-bytes>10M</max-hierarchical-bytes>
         </address-setting>
         <address-setting match="(America.*.*)">
            <max-hierarchical-messages>1000</max-hierarchical-messages>
         </address-setting>
         <address-setting match="(Europe.*.*)">
            <max-hierarchical-messages>1000</max-hierarchical-messages>
         </address-setting>
         <address-setting match="(Asia.*.*)">
            <max-hierarchical-messages>1000</max-hierarchical-messages>
         </address-setting>
      </address-settings>

      <addresses>
         <!-- Continent level addresses -->
         <address name="America.*.*">
            <anycast/>
         </address>
         <address name="America.50.*">
            <anycast/>
         </address>
         <address name="Europe.*.*">
            <anycast/>
         </address>
         <address name="Asia.*.*">
            <anycast/>
         </address>
      </addresses>

   </core>

</configuration>
